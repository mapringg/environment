#!/usr/bin/env python3
import re
import socket
import sys


def main():
    mac = sys.stdin.read(128).strip().replace(":", "").replace("-", "")
    if not re.fullmatch(r"[0-9a-fA-F]{12}", mac):
        raise SystemExit("Pass the desktop Ethernet MAC on standard input.")

    packet = bytes([255]) * 6 + bytes.fromhex(mac) * 16
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sender:
        sender.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        sender.sendto(packet, ("255.255.255.255", 9))
    print("Wake-on-LAN packet sent.")


if __name__ == "__main__":
    main()
