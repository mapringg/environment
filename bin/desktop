#!/usr/bin/env bash
set -euo pipefail

PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

wake() (
  if [ "$(hostname -s)" != ubuntu ]; then
    exec ssh ubuntu 'exec ~/code/mapringg/environment/bin/desktop wake'
  fi

  wake_dir=$(mktemp -d)
  helper="$HOME/code/mapringg/environment/bin/wake-desktop"
  trap 'rm -rf -- "$wake_dir"' EXIT
  cd "$wake_dir"
  secret init mapringg.machines.ops >/dev/null
  MISE_TRUSTED_CONFIG_PATHS="$wake_dir" MISE_ENV=ops mise exec -- bash -c \
    'printf "%s\n" "${DESKTOP_MAC:?Desktop Ethernet MAC is missing}" | "$1"' bash "$helper"
)

if [ "$#" -ne 1 ]; then
  echo 'Usage: desktop {wake|suspend|windows}' >&2
  exit 2
fi

case "$1" in
  wake) wake ;;
  suspend) exec ssh -t desktop 'sudo systemctl suspend' ;;
  windows) exec ssh -t desktop 'bash -ic reboot-windows' ;;
  *)
    echo 'Usage: desktop {wake|suspend|windows}' >&2
    exit 2
    ;;
esac
