#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
secret list                          list the items in the Dev vault
secret init [<item>...]              write fnox.local.toml and mise*.local.toml here
secret add <item> <NAME> <file|-> [--plain]
                                     store <file> as NAME and delete it; - prompts
secret export [<item>]               print KEY=VALUE lines for an item (human terminal use)
secret setup                         one-time machine setup; reads the token on stdin
secret save <item> <path>            store the file at <path> as a document
secret restore <item> <path>         write the document to <path> if it is missing
EOF
  exit 1
}

CLEAN=()
trap 'rm -rf ${CLEAN[@]+"${CLEAN[@]}"}' EXIT

token() { (cd ~ && mise x -- fnox get OP_SERVICE_ACCOUNT_TOKEN); }
op() { OP_SERVICE_ACCOUNT_TOKEN="$TOKEN" mise x -- op "$@"; }
items_here() { sed -n 's/^# secret init //p' fnox.local.toml 2>/dev/null | tr ' ' '\n' | sort -u; }

init() {
  [ $# -gt 0 ] || set -- $(items_here)
  [ $# -gt 0 ] || usage
  [ -z "$(printf '%s\n' "$@" | sed 's/.*\.//' | sort | uniq -d)" ] || { echo "secret: pass one item per environment" >&2; exit 1; }
  TOKEN=${TOKEN:-$(token)}
  local tmp item profile file
  tmp=$(mktemp -d)
  CLEAN+=("$tmp")
  for item; do
    op item get "$item" --vault Dev --format json >"$tmp/$item.json"
  done
  printf '%s\n' "# secret init $*" 'root = true' 'if_missing = "error"' >"$tmp/fnox.local.toml"
  for item; do
    jq -r --arg p "${item##*.}" --arg i "$item" '.fields[]
      | select(.type == "CONCEALED")
      | "\n[profiles.\($p).secrets.\(.label)]\nprovider = \"op\"\nvalue = \"op://Dev/\($i)/\(.label)\""' \
      "$tmp/$item.json" >>"$tmp/fnox.local.toml"
  done
  for item; do
    jq -e 'any(.fields[]; .type == "CONCEALED")' "$tmp/$item.json" >/dev/null || continue
    mise x -- fnox -c "$tmp/fnox.local.toml" -P "${item##*.}" sync -p sync-age -f >/dev/null
  done
  printf '%s\n' '{"fields": []}' >"$tmp/none.json"
  local dev=$tmp/none.json
  for item; do [ "${item##*.}" = dev ] && dev=$tmp/$item.json; done
  for item; do
    profile=${item##*.}
    file=mise.local.toml
    [ "$profile" = dev ] || file=mise.$profile.local.toml
    jq -r --arg p "$profile" --arg q "'" --slurpfile dev "$dev" '
      [.fields[] | select(.purpose != "NOTES")] as $f
      | ($f | map(.label)) as $mine
      | "[secrets.fnox]\nprofile = \"\($p)\"\n\n[env]",
        ($f[] | select(.type == "STRING") | (.value // "") as $v
          | if $p != "dev" or ($v | test("[{}\\\\" + $q + "]")) then "\(.label) = \($v | tojson)"
            else "\(.label) = \("{{ get_env(name=\($q)\(.label)\($q), default=\($q)\($v)\($q)) }}" | tojson)" end),
        (if $p == "dev" then empty else
          $dev[0].fields[] | select(.type == "STRING" and .purpose != "NOTES")
          | select(.label as $l | $mine | index($l) | not) | "\(.label) = false" end),
        "\n[tasks.pnpm]",
        "description = \"Run pnpm with the \($p) secrets from 1Password\"",
        ([$f[] | select(.type == "CONCEALED") | .label | tojson] as $s
          | "secrets = [\($s | join(", "))]" as $line
          # Formatters such as oxfmt scan this ignored file, so match their TOML style at the 120-column width.
          | if ($line | length) <= 120 then $line else "secrets = [\n\($s | map("  \(.),\n") | join(""))]" end),
        "run = \"pnpm\""' "$tmp/$item.json" >"$tmp/$file"
  done
  for item; do
    file=mise.local.toml
    [ "${item##*.}" = dev ] || file=mise.${item##*.}.local.toml
    mv "$tmp/$file" "$file"
    mise trust -q "$file"
  done
  mv "$tmp/fnox.local.toml" fnox.local.toml
  echo "secret: $* ready in $PWD"
}

add() {
  [ $# -ge 3 ] || usage
  local item=$1 name=$2 file=$3 type=CONCEALED json err v
  [ "${4:-}" = --plain ] && type=STRING
  if [ "$file" = - ]; then
    file=$(mktemp)
    read -rsp "$name: " v </dev/tty && echo >/dev/tty && printf %s "$v" >"$file" && v=
  fi
  CLEAN+=("$file")
  if [ "$type" = CONCEALED ] && [ "$(tr -d '\n' <"$file" | wc -c)" -lt 4 ]; then
    echo "secret: $name is under 4 characters, too short to hide in logs; pass --plain if it is not secret" >&2
    exit 1
  fi
  TOKEN=$(token)
  err=$(mktemp)
  CLEAN+=("$err")
  if json=$(op item get "$item" --vault Dev --reveal --format json 2>"$err"); then
    jq --arg n "$name" --arg t "$type" --rawfile v "$file" \
      '.fields |= map(select(.label != $n)) + [{id: $n, label: $n, type: $t, value: ($v | sub("\n$"; ""))}]' <<<"$json" |
      op item edit "$item" --vault Dev --format json >/dev/null
  elif grep -q "isn't an item" "$err"; then
    jq -n --arg i "$item" --arg n "$name" --arg t "$type" --rawfile v "$file" \
      '{title: $i, category: "SECURE_NOTE", fields: [{id: $n, label: $n, type: $t, value: ($v | sub("\n$"; ""))}]}' |
      op item create --vault Dev --tags "org/${item%%.*},env/${item##*.},kind/dotenv" --format json >/dev/null
  else
    echo "secret: could not read $item from 1Password" >&2
    exit 1
  fi
  rm -f "$file"
  echo "secret: stored $name in $item"
  if [ -f fnox.local.toml ]; then
    init $( { items_here; echo "$item"; } | sort -u)
  else
    echo "secret: run 'secret init $item' in the app folder to use it"
  fi
}

setup() {
  umask 077
  mkdir -p ~/.config/fnox
  [ -f ~/.config/fnox/age.txt ] || mise x -- age-keygen -o ~/.config/fnox/age.txt 2>/dev/null
  grep -q OP_SERVICE_ACCOUNT_TOKEN ~/.config/fnox/config.toml 2>/dev/null && return
  cat >~/.config/fnox/config.toml <<EOF
[providers.sync-age]
type = "age"
recipients = ["$(mise x -- age-keygen -y ~/.config/fnox/age.txt)"]
key_file = "~/.config/fnox/age.txt"

[providers.op]
type = "1password"
vault = "Dev"
token = { secret = "OP_SERVICE_ACCOUNT_TOKEN" }
EOF
  (cd ~ && mise x -- fnox set -g OP_SERVICE_ACCOUNT_TOKEN -p sync-age >/dev/null)
  local tmp_cfg
  tmp_cfg=$(mktemp)
  CLEAN+=("$tmp_cfg")
  sed -E 's/^(OP_SERVICE_ACCOUNT_TOKEN ?= \{.*")( \})$/\1, env = false\2/' ~/.config/fnox/config.toml >"$tmp_cfg"
  mv "$tmp_cfg" ~/.config/fnox/config.toml
  grep -q 'env = false' ~/.config/fnox/config.toml || { echo "secret: could not mark the token env = false" >&2; exit 1; }
}

save() {
  [ $# -eq 2 ] && [ -f "$2" ] || usage
  TOKEN=$(token)
  if op item get "$1" --vault Dev >/dev/null 2>&1; then
    op document edit "$1" "$2" --vault Dev >/dev/null
  else
    op document create "$2" --title "$1" --vault Dev --tags "org/${1%%.*},kind/file" >/dev/null
  fi
  echo "secret: stored $2 in $1"
}

restore() {
  [ $# -eq 2 ] || usage
  [ -e "$2" ] && return
  TOKEN=$(token)
  local tmp
  tmp=$(mktemp -d)
  CLEAN+=("$tmp")
  op document get "$1" --vault Dev --out-file "$tmp/file" >/dev/null
  mkdir -p "$(dirname "$2")"
  install -m 600 "$tmp/file" "$2"
  echo "secret: restored $2 from $1"
}

export_item() {
  local item=${1:-$(items_here | head -n 1)}
  [ -n "$item" ] || usage
  TOKEN=$(token)
  op item get "$item" --vault Dev --reveal --format json | jq -r '
    .fields[]
    | select(.purpose != "NOTES" and (.label // "") != "")
    | "\(.label)=\((.value // "") | if test("[\\s#\"'\''$`\\\\]") then tojson else . end)"'
}

case ${1:-} in
list) TOKEN=$(token) && op item list --vault Dev --format json | jq -r '.[].title' | sort ;;
init) shift && init "$@" ;;
add) shift && add "$@" ;;
export) shift && export_item "$@" ;;
setup) setup ;;
save) shift && save "$@" ;;
restore) shift && restore "$@" ;;
*) usage ;;
esac
